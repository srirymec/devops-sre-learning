<server description="new server">

    <!-- Enable features -->
    <featureManager>
            <feature>jsp-2.2</feature>
            <feature>jdbc-4.0</feature>
     </featureManager>

    <httpEndpoint id="defaultHttpEndpoint"
                      host="*"
                      httpPort="9080"
                      httpsPort="8443" />

   <dataSource id="ds1" jndiName="jdbc/test" jdbcDriverRef="mysqlDriver">
   <properties databaseName="test"
   url= "jdbc:mysql://<%= @rdsEndPoint %>:3306/test"
   portNumber="3306"
   user="root"
   password="Welcome123"/>
   </dataSource>

   <jdbcDriver id="mysqlDriver" libraryRef="JDBCSampleMysqlLibs"/>

   <library id="JDBCSampleMysqlLibs">
     <fileset dir="${shared.resource.dir}/mysqlLibs" includes="mysql-connector-java-5.1.24.jar" scanInterval="5s" />
   </library>

</server>

